{
  "name": "rankly-ai-backend",
  "version": "1.0.0",
  "description": "Rankly.ai - Next-Gen Executive AI Screening & Candidate Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node -e \"process.env.DATABASE_URL=process.env.DATABASE_URL||'file:./rankly.db'; require('child_process').execSync('npx prisma generate', {stdio:'inherit', env:process.env})\"",
    "dev": "nodemon server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:studio": "npx prisma studio"
  },
  "keywords": [
    "rankly",
    "ats",
    "resume-screening",
    "ai",
    "prisma",
    "sqlite",
    "express"
  ],
  "author": "Rankly Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "adm-zip": "^0.6.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "connect-sqlite3": "^0.9.18",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "ldrs": "^1.1.9",
    "mammoth": "^1.12.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "socket.io": "^4.7.5",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1"
  }
}
