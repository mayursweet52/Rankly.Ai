# ─── SERVER & DATABASE (Production / Railway / Render) ───
PORT=3000
NODE_ENV=production
BASE_URL=https://rankly-ai-production.up.railway.app
APP_URL=https://rankly-ai-production.up.railway.app
DATABASE_URL=file:./rankly.db
SESSION_SECRET=rankly_secure_session_key_2026_super_secret

# ─── 10 AI PROVIDERS ──────────────────────────────────────────

# 1. Groq (Ultra-Fast Cloud Inference)
GROQ_API_KEY=

# 2. Google Gemini
GEMINI_API_KEY=

# 3. OpenRouter (Universal AI Gateway)
OPENROUTER_API_KEY=

# 4. Cerebras (Ultra-Fast Llama-3.1-70b)
CEREBRAS_API_KEY=

# 5. Cloudflare Workers AI
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 6. Mistral AI
MISTRAL_API_KEY=

# 7. Hugging Face Inference API
HF_API_KEY=

# 8. Cohere
COHERE_API_KEY=

# 9. Ollama (Local Offline Fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# 10. Together AI
TOGETHER_API_KEY=

# ─── SMTP / EMAIL CONFIGURATION ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Rankly.ai <support@rankly.ai>

# ─── RATE LIMITING (Configurable Thresholds & Tiers) ─────────
# Auth Endpoints (Strict burst limit per IP)
RATE_LIMIT_AUTH_WINDOW_MS=900000        # 15 mins (in ms)
RATE_LIMIT_AUTH_MAX_IP=30               # Max auth requests per IP per window

# Auth Exponential Backoff (Per-Account & Per-IP failure protection)
RATE_LIMIT_AUTH_FAIL_THRESHOLD=5        # Failures before backoff starts
RATE_LIMIT_AUTH_BASE_BACKOFF_MS=2000    # Initial backoff delay (2 seconds)
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=2    # Multiplier for subsequent attempts
RATE_LIMIT_AUTH_MAX_BACKOFF_MS=900000   # Maximum delay cap (15 mins)
RATE_LIMIT_AUTH_RESET_TIME_MS=900000    # Inactivity window to reset failures (15 mins)

# Public Endpoints (Moderate limits for guests / unauthenticated requests)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000      # 15 mins (in ms)
RATE_LIMIT_PUBLIC_MAX=300               # 300 requests per 15 mins

# Authenticated User Actions (Looser limits for logged-in sessions)
RATE_LIMIT_AUTHED_WINDOW_MS=900000      # 15 mins (in ms)
RATE_LIMIT_AUTHED_MAX=1500              # 1500 requests per 15 mins

# AI & Heavy Processing (Burst limit for AI chat & resume screening)
RATE_LIMIT_AI_WINDOW_MS=60000           # 1 min (in ms)
RATE_LIMIT_AI_MAX=60                    # 60 requests per min

