# ─── SERVER & DATABASE ───
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
DATABASE_URL=file:./rankly.db
SESSION_SECRET=rankly_super_secret_2026
JWT_SECRET=antigravity_jwt_super_secure_secret_key_2026

# ─── 10 AI PROVIDERS ──────────────────────────────────────────
# 1. Groq
GROQ_API_KEY=your_groq_api_key

# 2. Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# 3. OpenRouter (DeepSeek + Qwen)
OPENROUTER_API_KEY=your_openrouter_api_key

# 4. Cerebras
CEREBRAS_API_KEY=your_cerebras_api_key

# 5. Cloudflare AI
CLOUDFLARE_AI_TOKEN=your_cloudflare_ai_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# 6. Mistral AI
MISTRAL_API_KEY=your_mistral_api_key

# 7. Hugging Face
HF_API_KEY=your_hf_api_key

# 8. Cohere
COHERE_API_KEY=your_cohere_api_key

# 9. Ollama (Local Fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b


# ─── OPTIONAL OAUTH & TURNSTILE ──────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── SMTP / EMAIL CONFIGURATION ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Rankly.ai <your_email@gmail.com>
DEVELOPER_EMAIL=your_email@gmail.com
RESEND_API_KEY=
