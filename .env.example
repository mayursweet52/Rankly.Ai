# ─── SERVER & DATABASE ───
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL="file:./rankly.db"
SESSION_SECRET=rankly_super_secret_2026

# ─── 10 AI PROVIDERS ──────────────────────────────────────────

# 1. Groq (Ultra-Fast Cloud Inference)
GROQ_API_KEY=

# 2. Google Gemini
GEMINI_API_KEY=

# 3. OpenRouter (Universal AI Gateway)
OPENROUTER_API_KEY=

# 4. Cerebras (Ultra-Fast Llama-3.1-70b)
CEREBRAS_API_KEY=

# 5. Cloudflare Workers AI
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 6. Mistral AI
MISTRAL_API_KEY=

# 7. Hugging Face Inference API
HF_API_KEY=

# 8. Cohere
COHERE_API_KEY=

# 9. Ollama (Local Offline Fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# 10. Together AI
TOGETHER_API_KEY=

# ─── SMTP / EMAIL CONFIGURATION ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Rankly.ai <support@rankly.ai>
