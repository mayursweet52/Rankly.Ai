            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append Row to Google Sheet": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
