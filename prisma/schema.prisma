// Prisma Schema for Rankly.ai
// Database: SQLite with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// User Model (Dual Track: Normal Jobseeker vs HR/Enterprise)
// ---------------------------------------------------------
model User {
  id              String        @id @default(uuid())
  accountType     String        @default("normal_user") // "normal_user" | "employee"
  firstName       String
  lastName        String?
  username        String?       @unique
  email           String        @unique
  phone           String?       @unique
  password        String
  
  // Normal Jobseeker Details
  dob             DateTime?
  age             Int?
  gender          String?
  profession      String?
  linkedInUrl     String?
  isEmailVerified Boolean       @default(false)
  isPhoneVerified Boolean       @default(false)

  // Enterprise / HR Specific
  role            String        @default("normal_user") // "admin" | "hr" | "hiring_manager" | "normal_user"
  workEmail       String?
  status          String        @default("active")      // "active" | "pending_approval" | "suspended"
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Relations
  evaluations      Evaluation[]
  candidates       Candidate[]
  chatMessages     ChatMessage[]
  feedbacks        Feedback[]
  createdReferrals ReferralCode[] @relation("CreatedReferrals")
  administeredOrgs Organization[] @relation("AdminOrgs")
  employeeProfile  Employee?
  companyDocuments CompanyDocument[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([accountType, role, status])
  @@index([createdAt])
}

// ---------------------------------------------------------
// Organization Model
// ---------------------------------------------------------
model Organization {
  id          String           @id @default(uuid())
  name        String
  adminId     String
  admin       User             @relation("AdminOrgs", fields: [adminId], references: [id], onDelete: Cascade)
  
  members     User[]
  evaluations Evaluation[]
  candidates  Candidate[]
  referrals   ReferralCode[]
  invitations TeamInvitation[]
  departments Department[]
  employees   Employee[]
  companyDocuments CompanyDocument[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// ---------------------------------------------------------
// Referral Code Model (For inviting HR / Hiring Managers)
// ---------------------------------------------------------
model ReferralCode {
  id             String       @id @default(uuid())
  code           String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedRole   String       @default("hr") // "hr" | "hiring_manager"
  createdById    String
  createdBy      User         @relation("CreatedReferrals", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  maxUses        Int          @default(1)
  usedCount      Int          @default(0)
  isUsed         Boolean      @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ---------------------------------------------------------
// Candidate / Resume Evaluation Model
// ---------------------------------------------------------
model Evaluation {
  id              String        @id @default(uuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  
  isPractice      Boolean       @default(false)
  candidateName   String?
  candidateEmail  String?
  candidatePhone  String?
  targetRole      String
  resumeFileName  String?
  resumeFilePath  String?
  extractedText   String?

  matchScore      Float         @default(0)
  skillsScore     Float         @default(0)
  experienceScore Float         @default(0)
  toolsScore      Float         @default(0)
  educationScore  Float         @default(0)
  fitVerdict      String?       // "Strong Fit", "Moderate Fit", "Potential Fit", "Not a Fit"

  summary         String?
  matchedSkills   String?       // Stored as JSON array string
  missingSkills   String?       // Stored as JSON array string
  recommendations String?       // Stored as JSON array string

  pipelineStage   String        @default("applied") // "applied" | "ai_screened" | "hm_review" | "interview" | "offered" | "rejected"
  status          String        @default("screened") // "submitted" | "screened" | "sent_to_hr" | "shortlisted" | "rejected"
  hmNotes         String?
  rawAiResponse   String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([pipelineStage, status])
}

// ---------------------------------------------------------
// Pipeline Candidate Model (For ATS Kanban & Tracking)
// ---------------------------------------------------------
model Candidate {
  id              String        @id @default(uuid())
  name            String
  email           String?
  phone           String?
  targetRole      String
  stage           String        @default("applied") // "applied" | "ai_screened" | "hm_review" | "interview" | "offered" | "rejected"
  
  score           Float         @default(0)
  skillsScore     Float         @default(0)
  experienceScore Float         @default(0)
  toolsScore      Float         @default(0)
  educationScore  Float         @default(0)
  fitVerdict      String?
  summary         String?
  matchedSkills   String?       // JSON array string
  missingSkills   String?       // JSON array string
  recommendations String?       // JSON array string
  notes           String?
  resumeUrl       String?
  extractedText   String?

  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  evaluationId    String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, stage])
  @@index([email])
  @@index([createdAt])
}

// ---------------------------------------------------------
// OTP Verification Model
// ---------------------------------------------------------
model OTP {
  id        String   @id @default(uuid())
  email     String?
  phone     String?
  otp       String
  type      String   @default("email_verification") // "email_verification" | "password_reset" | "phone_verification"
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, isUsed, expiresAt])
  @@index([createdAt])
}

// ---------------------------------------------------------
// Chat History Model (For AI Career Counselor & Q&A)
// ---------------------------------------------------------
model ChatMessage {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system"
  content   String
  meta      String?  // JSON metadata (e.g., target role, match context)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// Team Invitation Model
// ---------------------------------------------------------
model TeamInvitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("hr") // "hr" | "hiring_manager"
  token          String       @unique
  status         String       @default("pending") // "pending" | "accepted" | "rejected" | "expired"
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ---------------------------------------------------------
// Feedback Model (For User & Recruiter Feedback)
// ---------------------------------------------------------
model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String?
  email     String?
  rating    Int?     @default(5)
  category  String   @default("general") // "general" | "bug" | "feature" | "ui_ux"
  message   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// Department Model
// ---------------------------------------------------------
model Department {
  id             String       @id @default(uuid())
  name           String       // e.g. "Engineering", "Human Resources", "Finance", "Product"
  code           String       // e.g. "ENG", "HR", "FIN", "PROD"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  employees      Employee[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
}

// ---------------------------------------------------------
// Employee Model (Core Profile & Hierarchy)
// ---------------------------------------------------------
model Employee {
  id                       String               @id @default(uuid())
  employeeCode             String               @unique // e.g. "EMP-001"
  userId                   String?              @unique
  user                     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId           String
  organization             Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Basic Personal Information
  firstName                String
  lastName                 String?
  personalEmail            String?
  workEmail                String               @unique
  phoneNumber              String?
  dob                      DateTime?
  gender                   String?              // "male" | "female" | "other" | "prefer_not_to_say"
  maritalStatus            String?              // "single" | "married" | "other"
  currentAddress           String?
  permanentAddress         String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Role, Department & Employment Details
  departmentId             String
  department               Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation              String               // e.g. "Lead Software Engineer"
  employmentType           String               @default("full_time") // "full_time" | "part_time" | "contract" | "intern"
  employmentStatus         String               @default("active")    // "active" | "probation" | "notice_period" | "terminated" | "on_leave"
  dateOfJoining            DateTime
  dateOfExit               DateTime?

  // Reporting Hierarchy (Self-referencing relationship)
  reportingManagerId       String?
  reportingManager         Employee?            @relation("ManagementHierarchy", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  reportees                Employee[]           @relation("ManagementHierarchy")

  // Financial & Compensation Relations
  bankDetails              EmployeeBankDetails?
  salary                   EmployeeSalary?
  salaryRevisions          SalaryRevision[]

  // Access Control Roles
  accessRoles              EmployeeAccessRole[]

  // Skill Marketplace & Upskilling
  skills                   EmployeeSkill[]
  trainingRecommendations  RecommendedTraining[]
  draftedEmails            AgentEmailDraft[]

  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
}

// ---------------------------------------------------------
// Employee Bank Details Model (Financials)
// ---------------------------------------------------------
model EmployeeBankDetails {
  id                String    @id @default(uuid())
  employeeId        String    @unique
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  accountHolderName String
  bankName          String
  accountNumber     String    // Stored with encryption or masking
  ifscCode          String
  branchName        String?
  panNumber         String?
  aadhaarNumber     String?

  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ---------------------------------------------------------
// Employee Salary Model (Current Compensation Breakdown)
// ---------------------------------------------------------
model EmployeeSalary {
  id               String    @id @default(uuid())
  employeeId       String    @unique
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  annualCtc        Float     // Gross annual CTC
  basicSalary      Float     // Base pay
  hra              Float     // House Rent Allowance
  specialAllowance Float     @default(0)
  pfDeduction      Float     @default(0) // Provident Fund deduction
  professionalTax  Float     @default(0) // PT
  tds              Float     @default(0) // Tax deducted at source
  netMonthlyPay    Float     // In-hand monthly salary

  currency         String    @default("INR")
  paymentFrequency String    @default("monthly") // "monthly" | "bi_weekly"
  effectiveFrom    DateTime  @default(now())

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ---------------------------------------------------------
// Salary Revision Audit Trail Model
// ---------------------------------------------------------
model SalaryRevision {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  previousCtc    Float
  newCtc         Float
  hikePercentage Float
  reason         String?   // "annual_appraisal" | "promotion" | "market_correction" | "probation_confirmation"
  effectiveDate  DateTime
  approvedById   String?

  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------
// Access Control Models (Multi-Level RBAC)
// ---------------------------------------------------------
model AccessRole {
  id          String               @id @default(uuid())
  name        String               @unique // "employee", "team_lead", "dept_head", "hr_admin", "super_admin"
  displayName String
  level       Int                  @default(1) // Level 1 (lowest) to Level 5 (highest executive)
  description String?

  permissions RolePermission[]
  employees   EmployeeAccessRole[]

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. "employee:read", "salary:write", "leaves:approve"
  name        String
  category    String           // "employee" | "salary" | "leaves" | "ats" | "system"
  description String?

  roles       RolePermission[]

  createdAt   DateTime         @default(now())
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model EmployeeAccessRole {
  id         String     @id @default(uuid())
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleId     String
  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime   @default(now())

  @@unique([employeeId, roleId])
}

// =========================================================
// 2. AI AGENT MODULE DATA MODELS (Anti-Gravity Spec v1.0)
// =========================================================
model AiAgent {
  id                  String                  @id @default(uuid())
  agentId             String                  @unique // e.g. "agent_ai_8892"
  name                String                  // e.g. "Operations Co-Pilot", "HR Assistant Agent"
  modelType           String                  @default("nvidia/nemotron-3-ultra-550b-a55b") // "llama3.3:8b" | "nvidia/nemotron-3-ultra-550b-a55b"
  capabilities        String                  @default("[]") // JSON Array: ["automated_email_drafting", "database_semantic_retrieval", "skill_gap_analysis"]
  status              String                  @default("active")

  conversations       AgentConversation[]
  emailDrafts         AgentEmailDraft[]
  analyticsMetrics    AgentAnalyticsMetrics?

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model AgentConversation {
  id        String   @id @default(uuid())
  agentId   String
  agent     AiAgent  @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system"
  message   String
  createdAt DateTime @default(now())
}

model AgentEmailDraft {
  id          String    @id @default(uuid())
  draftId     String    @unique // e.g. "drf_1029"
  agentId     String
  agent       AiAgent   @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  recipient   String    // Recipient email
  subject     String
  body        String?
  status      String    @default("pending_approval") // "pending_approval" | "approved" | "sent" | "rejected"
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AgentAnalyticsMetrics {
  id                 String   @id @default(uuid())
  agentId            String   @unique
  agent              AiAgent  @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  satisfactionScore  Float    @default(4.85)
  responseTimeMs     Int      @default(320)
  totalQueriesServed Int      @default(0)

  updatedAt          DateTime @updatedAt
}

// =========================================================
// 3. INTERNAL SKILL MARKETPLACE DATA MODELS (Anti-Gravity Spec v1.0)
// =========================================================
model Skill {
  id          String                @id @default(uuid())
  skillId     String                @unique // Master Primary Key, e.g. "SKL_NODE_01", "SKILL_REACT"
  name        String                // e.g. "Node.js & Express Microservices"
  category    String                // Domain: "Backend Engineering", "Frontend", "Cloud Infra"

  employees   EmployeeSkill[]
  trainings   RecommendedTraining[]

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model EmployeeSkill {
  id                String   @id @default(uuid())
  assignmentId      String   @unique // e.g. "ESK_8831"
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId           String
  skill             Skill    @relation(fields: [skillId], references: [skillId], onDelete: Cascade)
  proficiencyLevel  String   // "Beginner" | "Intermediate" | "Advanced" | "Master"
  yearsOfExperience Float    // e.g. 4.5

  assignedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeId, skillId])
}

model RecommendedTraining {
  id               String   @id @default(uuid())
  recommendationId String   @unique // e.g. "REC_9912"
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill    @relation(fields: [skillId], references: [skillId], onDelete: Cascade)
  courseName       String   // e.g. "Cloud Native Kubernetes Architecture"
  status           String   @default("Assigned") // "Assigned" | "In Progress" | "Completed" | "Waived"

  assignedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------
// Company Document Model (Internal HRMS Policies, Handbooks & NDAs)
// ---------------------------------------------------------
model CompanyDocument {
  id             String        @id @default(uuid())
  title          String
  category       String        @default("policy") // "policy" | "handbook" | "contract" | "nda" | "compliance"
  description    String?
  fileUrl        String?
  fileName       String?
  fileSize       String?
  content        String?       // Document body / rich text / guidelines
  uploadedById   String
  uploadedBy     User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isRestricted   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
