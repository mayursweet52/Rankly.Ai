// Prisma Schema for Rankly.ai
// Database: SQLite with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// User Model (Dual Track: Normal Jobseeker vs HR/Enterprise)
// ---------------------------------------------------------
model User {
  id          String  @id @default(uuid())
  accountType String  @default("normal_user") // "normal_user" | "employee"
  firstName   String
  lastName    String?
  username    String? @unique
  email       String  @unique
  phone       String? @unique
  password    String

  // Normal Jobseeker Details
  dob             DateTime?
  age             Int?
  gender          String?
  profession      String?
  linkedInUrl     String?
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)

  // Enterprise / HR Specific
  role           String        @default("normal_user") // "admin" | "hr" | "hiring_manager" | "normal_user"
    isSuperAdmin   Boolean       @default(false)
    userRoles      UserRole[]
  workEmail      String?
  status         String        @default("active") // "active" | "pending_approval" | "suspended"
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Relations
  memberships      OrganizationMember[]
  evaluations      Evaluation[]
  candidates       Candidate[]
  chatMessages     ChatMessage[]
  feedbacks        Feedback[]
  createdReferrals ReferralCode[]         @relation("CreatedReferrals")
  administeredOrgs Organization[]         @relation("AdminOrgs")
  employeeProfiles Employee[]
  companyDocuments CompanyDocument[]
  grievances       Grievance[]
  applications     CandidateApplication[]
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountType, role, status])
  @@index([createdAt])
}

// ---------------------------------------------------------
// Organization Model
// ---------------------------------------------------------

// ---------------------------------------------------------
// Organization Member (Many-to-Many Workspace Architecture)
// ---------------------------------------------------------
model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String       @default("employee") // "admin", "hr", "employee"
  status         String       @default("active") // "active", "invited", "suspended"
  joinedAt       DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Organization {
  id      String @id @default(uuid())
  name    String
  tenantCode String? @unique @default(uuid()) // Unique Company Code for Database Sharding
  adminId String
  admin   User   @relation("AdminOrgs", fields: [adminId], references: [id], onDelete: Cascade)

  // Many-to-Many Memberships
  memberships      OrganizationMember[]

  // Legacy fallback
  members          User[]
  evaluations      Evaluation[]
  candidates       Candidate[]
  referrals        ReferralCode[]
  invitations      TeamInvitation[]
  departments      Department[]
  employees        Employee[]
  companyDocuments CompanyDocument[]
  onboardingTemplates OnboardingTemplate[]
  grievances       Grievance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Security & IAM
  isIpRestrictionEnabled Boolean @default(false)
  allowedIps             String?
  allowedDomains         String? // Comma separated list of domains (Zero-Trust)
  isUnderLockdown        Boolean @default(false) // DEFCON 1 Kill Switch
  lockdownExpiresAt      DateTime? // 2-hour jam timer // Comma separated list of IPs

  // Geofencing Defaults
  officeLatitude  Float?
  officeLongitude Float?
  geofenceRadius  Int?   @default(100) // in meters
}

// ---------------------------------------------------------
// Referral Code Model (For inviting HR / Hiring Managers)
// ---------------------------------------------------------
model ReferralCode {
  id             String       @id @default(uuid())
  code           String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedRole   String       @default("hr") // "hr" | "hiring_manager"
  createdById    String
  createdBy      User         @relation("CreatedReferrals", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  maxUses        Int          @default(1)
  usedCount      Int          @default(0)
  isUsed         Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Candidate / Resume Evaluation Model
// ---------------------------------------------------------
model Evaluation {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  isPractice     Boolean @default(false)
  candidateName  String?
  candidateEmail String?
  candidatePhone String?
  targetRole     String
  resumeFileName String?
  resumeFilePath String?
  extractedText  String?

  matchScore      Float   @default(0)
  skillsScore     Float   @default(0)
  experienceScore Float   @default(0)
  toolsScore      Float   @default(0)
  educationScore  Float   @default(0)
  fitVerdict      String? // "Strong Fit", "Moderate Fit", "Potential Fit", "Not a Fit"

  summary         String?
  matchedSkills   String? // Stored as JSON array string
  missingSkills   String? // Stored as JSON array string
  recommendations String? // Stored as JSON array string

  pipelineStage String  @default("applied") // "applied" | "ai_screened" | "hm_review" | "interview" | "offered" | "rejected"
  status        String  @default("screened") // "submitted" | "screened" | "sent_to_hr" | "shortlisted" | "rejected"
  hmNotes       String?
  rawAiResponse String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([pipelineStage, status])
}

// ---------------------------------------------------------
// Pipeline Candidate Model (For ATS Kanban & Tracking)
// ---------------------------------------------------------
model Candidate {
  id         String  @id @default(uuid())
  name       String
  email      String?
  phone      String?
  targetRole String
  stage      String  @default("applied") // "applied" | "ai_screened" | "hm_review" | "interview" | "offered" | "rejected"

  score           Float   @default(0)
  skillsScore     Float   @default(0)
  experienceScore Float   @default(0)
  toolsScore      Float   @default(0)
  educationScore  Float   @default(0)
  fitVerdict      String?
  summary         String?
  matchedSkills   String? // JSON array string
  missingSkills   String? // JSON array string
  recommendations String? // JSON array string
  notes           String?
  resumeUrl       String?
  extractedText   String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  evaluationId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, stage])
  @@index([email])
  @@index([createdAt])
}

// ---------------------------------------------------------
// OTP Verification Model
// ---------------------------------------------------------
model OTP {
  id        String   @id @default(uuid())
  email     String?
  phone     String?
  otp       String
  type      String   @default("email_verification") // "email_verification" | "password_reset" | "phone_verification"
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, isUsed, expiresAt])
  @@index([createdAt])
}

// ---------------------------------------------------------
// Chat History Model (For AI Career Counselor & Q&A)
// ---------------------------------------------------------
model ChatMessage {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant" | "system"
  content   String
  meta      String? // JSON metadata (e.g., target role, match context)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// Team Invitation Model
// ---------------------------------------------------------
model TeamInvitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("employee") // "admin", "hr", "employee"
  employeeId     String?      // Links invite to HR Data
  token          String       @unique
  status         String       @default("pending") // "pending" | "accepted" | "rejected" | "expired"
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ---------------------------------------------------------
// Feedback Model (For User & Recruiter Feedback)
// ---------------------------------------------------------
model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String?
  email     String?
  rating    Int?     @default(5)
  category  String   @default("general") // "general" | "bug" | "feature" | "ui_ux"
  message   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// Department Model
// ---------------------------------------------------------
model Department {
  id             String       @id @default(uuid())
  name           String // e.g. "Engineering", "Human Resources", "Finance", "Product"
  code           String // e.g. "ENG", "HR", "FIN", "PROD"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
}

// ---------------------------------------------------------
// Employee Model (Core Profile & Hierarchy)
// ---------------------------------------------------------
model Employee {
  id             String       @id @default(uuid())
  employeeCode   String       @unique // e.g. "EMP-001"
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Basic Personal Information
  firstName                String
  lastName                 String?
  personalEmail            String?
  workEmail                String    @unique
  phoneNumber              String?
  dob                      DateTime?
  gender                   String? // "male" | "female" | "other" | "prefer_not_to_say"
  maritalStatus            String? // "single" | "married" | "other"
  currentAddress           String?
  permanentAddress         String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

    // Zoho Org Chart & Assets
    managerId      String?
    manager        Employee?  @relation("ManagerToEmployee", fields: [managerId], references: [id], onDelete: SetNull)
    subordinates   Employee[] @relation("ManagerToEmployee")
    
    documents      String?    // JSON representation of uploaded docs (Aadhaar, PAN, etc)
    workLocation   String?    // E.g. "HQ - Mumbai", "Remote"


  // Role, Department & Employment Details
  departmentId     String
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation      String // e.g. "Lead Software Engineer"
  employmentType   String     @default("full_time") // "full_time" | "part_time" | "contract" | "intern"
  employmentStatus String     @default("active") // "active" | "probation" | "notice_period" | "terminated" | "on_leave"
  dateOfJoining    DateTime
  dateOfExit       DateTime?

  // Reporting Hierarchy (Self-referencing relationship)
  reportingManagerId String?
  reportingManager   Employee?  @relation("ManagementHierarchy", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  reportees          Employee[] @relation("ManagementHierarchy")

  // Financial & Compensation Relations
  bankDetails     EmployeeBankDetails?
  salary          EmployeeSalary?
  salaryRevisions SalaryRevision[]

  // Access Control Roles
  

  // Skill Marketplace & Upskilling
  skills                  EmployeeSkill[]
  trainingRecommendations RecommendedTraining[]
  draftedEmails           AgentEmailDraft[]

  // Attendance & Leave Management
  attendances    Attendance[]
  leaveRequests  LeaveRequest[] @relation("EmployeeLeaves")
  reviewedLeaves LeaveRequest[] @relation("ReviewedLeaves")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  employeeShifts     Shift[]             @relation("EmployeeShifts")
  employeeTimesheets Timesheet[]         @relation("EmployeeTimesheets")
  employeeReviews    PerformanceReview[] @relation("EmployeeReviews")
  onboarding         EmployeeOnboarding?
  @@unique([userId, organizationId])
}

// ---------------------------------------------------------
// Employee Bank Details Model (Financials)
// ---------------------------------------------------------
model EmployeeBankDetails {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  accountHolderName String
  bankName          String
  accountNumber     String // Stored with encryption or masking
  ifscCode          String
  branchName        String?
  panNumber         String?
  aadhaarNumber     String?

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Employee Salary Model (Current Compensation Breakdown)
// ---------------------------------------------------------
model EmployeeSalary {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  annualCtc        Float // Gross annual CTC
  basicSalary      Float // Base pay
  hra              Float // House Rent Allowance
  specialAllowance Float @default(0)
  pfDeduction      Float @default(0) // Provident Fund deduction
  professionalTax  Float @default(0) // PT
  tds              Float @default(0) // Tax deducted at source
  netMonthlyPay    Float // In-hand monthly salary

  currency         String   @default("INR")
  paymentFrequency String   @default("monthly") // "monthly" | "bi_weekly"
  effectiveFrom    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Salary Revision Audit Trail Model
// ---------------------------------------------------------
model SalaryRevision {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  previousCtc    Float
  newCtc         Float
  hikePercentage Float
  reason         String? // "annual_appraisal" | "promotion" | "market_correction" | "probation_confirmation"
  effectiveDate  DateTime
  approvedById   String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// Access Control Models (Multi-Level RBAC)
// ---------------------------------------------------------








// =========================================================
// 2. AI AGENT MODULE DATA MODELS (Anti-Gravity Spec v1.0)
// =========================================================
model AiAgent {
  id           String @id @default(uuid())
  agentId      String @unique // e.g. "agent_ai_8892"
  name         String // e.g. "Operations Co-Pilot", "HR Assistant Agent"
  modelType    String @default("nvidia/nemotron-3-ultra-550b-a55b") // "llama3.3:8b" | "nvidia/nemotron-3-ultra-550b-a55b"
  capabilities String @default("[]") // JSON Array: ["automated_email_drafting", "database_semantic_retrieval", "skill_gap_analysis"]
  status       String @default("active")

  conversations    AgentConversation[]
  emailDrafts      AgentEmailDraft[]
  analyticsMetrics AgentAnalyticsMetrics?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentConversation {
  id        String   @id @default(uuid())
  agentId   String
  agent     AiAgent  @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  role      String // "user" | "assistant" | "system"
  message   String
  createdAt DateTime @default(now())
}

model AgentEmailDraft {
  id         String    @id @default(uuid())
  draftId    String    @unique // e.g. "drf_1029"
  agentId    String
  agent      AiAgent   @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  recipient  String // Recipient email
  subject    String
  body       String?
  status     String    @default("pending_approval") // "pending_approval" | "approved" | "sent" | "rejected"
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentAnalyticsMetrics {
  id                 String  @id @default(uuid())
  agentId            String  @unique
  agent              AiAgent @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  satisfactionScore  Float   @default(4.85)
  responseTimeMs     Int     @default(320)
  totalQueriesServed Int     @default(0)

  updatedAt DateTime @updatedAt
}

// =========================================================
// 3. INTERNAL SKILL MARKETPLACE DATA MODELS (Anti-Gravity Spec v1.0)
// =========================================================
model Skill {
  id       String @id @default(uuid())
  skillId  String @unique // Master Primary Key, e.g. "SKL_NODE_01", "SKILL_REACT"
  name     String // e.g. "Node.js & Express Microservices"
  category String // Domain: "Backend Engineering", "Frontend", "Cloud Infra"

  employees EmployeeSkill[]
  trainings RecommendedTraining[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeSkill {
  id                String   @id @default(uuid())
  assignmentId      String   @unique // e.g. "ESK_8831"
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId           String
  skill             Skill    @relation(fields: [skillId], references: [skillId], onDelete: Cascade)
  proficiencyLevel  String // "Beginner" | "Intermediate" | "Advanced" | "Master"
  yearsOfExperience Float // e.g. 4.5

  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, skillId])
}

model RecommendedTraining {
  id               String   @id @default(uuid())
  recommendationId String   @unique // e.g. "REC_9912"
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill    @relation(fields: [skillId], references: [skillId], onDelete: Cascade)
  courseName       String // e.g. "Cloud Native Kubernetes Architecture"
  status           String   @default("Assigned") // "Assigned" | "In Progress" | "Completed" | "Waived"

  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------
// Company Document Model (Internal HRMS Policies, Handbooks & NDAs)
// ---------------------------------------------------------
model CompanyDocument {
  id             String        @id @default(uuid())
  title          String
  category       String        @default("policy") // "policy" | "handbook" | "contract" | "nda" | "compliance"
  description    String?
  fileUrl        String?
  fileName       String?
  fileSize       String?
  content        String? // Document body / rich text / guidelines
  uploadedById   String
  uploadedBy     User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isRestricted   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ---------------------------------------------------------
// Confidential Grievance Model (Report directly to Admin)
// ---------------------------------------------------------
model Grievance {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeName   String? // "Anonymous Employee" if isAnonymous is true
  employeeEmail  String? // null if isAnonymous is true
  category       String // "HR Issue", "Payroll", "Workplace", "Harassment", "Ethics", "Other"
  priority       String        @default("Normal") // "Normal", "Urgent", "Critical"
  subject        String
  description    String
  isAnonymous    Boolean       @default(false)
  status         String        @default("Pending") // "Pending", "Under Review", "Resolved", "Dismissed"
  adminNotes     String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ---------------------------------------------------------
// Attendance Model (Daily Tracking & Shift Work Hours)
// ---------------------------------------------------------
model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // Normalized date for the attendance day
  checkIn    DateTime?
  checkOut   DateTime?
  workHours  Float? // Total work hours logged for the shift
  status     String    @default("present") // "present" | "absent" | "half_day" | "late" | "on_leave" | "remote"
  notes      String?
  ipAddress  String?

  // Geofencing
  latitude        Float?
  longitude       Float?
  isGeofenceValid Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

// ---------------------------------------------------------
// Leave Request Model (Leave Applications, Approvals & Workflow)
// ---------------------------------------------------------
model LeaveRequest {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     String    @default("casual") // "casual" | "sick" | "earned" | "maternity" | "paternity" | "unpaid"
  startDate     DateTime
  endDate       DateTime
  daysCount     Float     @default(1.0)
  reason        String
  status        String    @default("pending") // "pending" | "approved" | "rejected" | "cancelled"
  reviewedById  String?
  reviewedBy    Employee? @relation("ReviewedLeaves", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewRemarks String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------
// Candidate Job Application Tracker Model
// ---------------------------------------------------------
model CandidateApplication {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  candidateEmail String?
  companyName    String
  jobTitle       String
  location       String?
  salaryRange    String?
  jobUrl         String?
  appliedDate    DateTime @default(now())
  stage          String   @default("applied") // "applied" | "under_review" | "shortlisted" | "interview" | "offered" | "rejected"
  notes          String?
  nextStep       String?
  matchScore     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, stage])
  @@index([candidateEmail])
  @@index([createdAt])
}

// ---------------------------------------------------------
// Applications Model (Strict Lifecycle Status Workflow)
// ---------------------------------------------------------
model Application {
  id               String   @id @default(uuid())
  candidateId      String
  jobTitle         String
  companyName      String?  @default("Rankly.ai")
  resumeUrl        String?
  matchScore       Float?   @default(0.0)
  status           String   @default("pending_screening") // "pending_screening" | "ai_shortlisted" | "hr_review_pending" | "hr_shortlisted" | "rejected"
  screeningVerdict String?
  screeningNotes   String?
  matchedSkills    String? // JSON array string
  missingSkills    String? // JSON array string
  hrReviewerId     String?
  hrFeedback       String?
  rejectionReason  String?
  appliedAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([candidateId])
  @@index([status])
  @@index([appliedAt])
}

// ---------------------------------------------------------
// Audit Logs Model (Immutable History for Actions & Lifecycle)
// ---------------------------------------------------------
model AuditLog {
  id             String       @id @default(uuid())
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action         String // "STATUS_CHANGE" | "APPLICATION_CREATED" | "AI_SCREENED" | "HR_REVIEW" | "REJECTED"
  previousStatus String?
  newStatus      String
  actorType      String       @default("system") // "system_ai" | "hr_admin" | "candidate"
  actorId        String?
  actorEmail     String?
  changeReason   String?
  metadata       String? // JSON details string
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([applicationId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Company {
  id           String       @id @default(uuid())
  name         String
  domain       String?
  atsPlatform  String?
  atsBoardSlug String?
  isRegistered Boolean      @default(false)
  createdAt    DateTime     @default(now())
  jobs         CompanyJob[]
}

model CompanyJob {
  id                    String   @id @default(uuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  jobTitle              String
  department            String?
  location              String?
  externalApplyUrl      String?
  ranklyApplicationSlug String   @unique
  status                String   @default("active")
  createdAt             DateTime @default(now())
}

// =========================================================
// HIGH-TRAFFIC HRMS MODULES (ZOHO BLUEPRINT)
// =========================================================

// ---------------------------------------------------------
// Shift Management
// ---------------------------------------------------------
model Shift {
  id                   String     @id @default(uuid())
  name                 String // e.g., "General[09AM - 06PM]"
  startTime            String // "09:00"
  endTime              String // "18:00"
  isDefault            Boolean    @default(false)
  allowanceRate        Float?     @default(0.0)
  minHoursForAllowance Float?     @default(0.0)
  employees            Employee[] @relation("EmployeeShifts")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([isDefault])
}

// ---------------------------------------------------------
// Timesheet & Billing Management
// ---------------------------------------------------------
model Client {
  id        String    @id @default(uuid())
  name      String
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id         String      @id @default(uuid())
  name       String
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  timesheets Timesheet[]
  createdAt  DateTime    @default(now())

  @@index([clientId])
}

model Timesheet {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation("EmployeeTimesheets", fields: [employeeId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  hoursWorked Float
  billable    Boolean  @default(true)
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())

  @@index([employeeId, date])
  @@index([projectId, status])
}

// ---------------------------------------------------------
// Performance & Evaluation Management
// ---------------------------------------------------------
model PerformanceReview {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String?
  reviewPeriod String // e.g., "Q3 2026"
  kraData      String? // JSON string of KRA & Goals
  feedback     String?
  competency   String? // JSON string
  finalRating  Float?
  status       String   @default("draft") // draft, submitted, acknowledged
  createdAt    DateTime @default(now())

  @@index([employeeId, reviewPeriod])
}


// ---------------------------------------------------------
// ONBOARDING & WORKFLOWS
// ---------------------------------------------------------

model OnboardingTemplate {
  id             String                   @id @default(uuid())
  name           String                   // e.g., "Standard Engineering Onboarding"
  description    String?
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          OnboardingTaskTemplate[]
  employeeRuns   EmployeeOnboarding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OnboardingTaskTemplate {
  id           String             @id @default(uuid())
  templateId   String
  template     OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assignedRole String?            // e.g., "IT", "HR", "Manager"
  orderIndex   Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeOnboarding {
  id           String               @id @default(uuid())
  employeeId   String               @unique
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId   String
  template     OnboardingTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  status       String               @default("in_progress") // "in_progress", "completed"
  progress     Int                  @default(0) // Percentage 0-100
  tasks        EmployeeOnboardingTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeOnboardingTask {
  id             String             @id @default(uuid())
  onboardingId   String
  onboarding     EmployeeOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assignedRole   String?
  status         String             @default("pending") // "pending", "completed", "skipped"
  completedAt    DateTime?
  orderIndex     Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Role {
  id          String   @id @default(uuid())
  name        String   @unique  // Admin khud naam dega
  description String?
  isSystem    Boolean  @default(false)  // Sirf Super Admin ke liye true
  createdBy   String?  // Kis admin ne banaya
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  userRoles   UserRole[]
  functionPermissions FunctionPermission[]
}

model Permission {
  id         String  @id @default(uuid())
  roleId     String
  formName   String  // "employee", "leave", "attendance", "payroll", etc.
  dataScope  String  // "NO_DATA", "MY_DATA", "SUBORDINATES", "MY_DATA_AND_SUBORDINATES", "ALL_DATA"
  canView    Boolean @default(false)
  canAdd     Boolean @default(false)
  canEdit    Boolean @default(false)
  canDelete  Boolean @default(false)

  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  fields     FieldPermission[]

  @@unique([roleId, formName])
}

model FieldPermission {
  id           String     @id @default(uuid())
  permissionId String
  fieldName    String
  canView      Boolean    @default(false)
  canEdit      Boolean    @default(false)

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, fieldName])
}

model FunctionPermission {
  id           String  @id @default(uuid())
  roleId       String
  functionName String
  allowed      Boolean @default(false)

  role         Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, functionName])
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime @default(now())

  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Module {
  id          String   @id @default(uuid())
  key         String   @unique  // "employee", "leave"
  label       String              // "Employee Management"
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}
